<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aula en Calma"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Control automático del ruido en clase"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vigilancia detenida"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="— / 100"
                android:textColor="@color/ink"
                android:textSize="44sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intensidad relativa del micrófono · no sonómetro calibrado"
                style="@style/HintText" />
            <ProgressBar
                android:id="@+id/progressLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/line"
                android:progressTint="@color/brand" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnStart"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Iniciar vigilancia" />
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnStop"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.65"
                    android:text="Detener" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Configuración"
            style="@style/CardTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Umbral de ruido" style="@style/CardTitle" />
            <TextView android:id="@+id/tvThresholdValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                style="@style/ValueText" android:text="65 / 100" />
            <SeekBar android:id="@+id/seekThreshold" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="100" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Hacia la derecha: admite más ruido antes de avisar."
                style="@style/HintText" />
            <Button android:id="@+id/btnCalibrate" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Calibrar aula durante 8 s" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="Con la vigilancia activa, mantén el ambiente al volumen que consideras adecuado."
                style="@style/HintText" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:padding="18dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Temporización" style="@style/CardTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="Ataque: ruido sostenido" style="@style/HintText" />
            <TextView android:id="@+id/tvAttackValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/ValueText" android:text="2,0 s" />
            <SeekBar android:id="@+id/seekAttack" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="19" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Release: silencio necesario para rearmar"
                style="@style/HintText" />
            <TextView android:id="@+id/tvReleaseValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/ValueText" android:text="3 s" />
            <SeekBar android:id="@+id/seekRelease" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="14" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Tiempo mínimo entre avisos"
                style="@style/HintText" />
            <TextView android:id="@+id/tvCooldownValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/ValueText" android:text="15 s" />
            <SeekBar android:id="@+id/seekCooldown" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="23" />
            <Switch android:id="@+id/switchRepeat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Repetir si el ruido continúa" android:textColor="@color/ink"
                android:textSize="15sp" />
            <TextView android:id="@+id/tvRepeatValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                style="@style/ValueText" android:text="Cada 30 s" />
            <SeekBar android:id="@+id/seekRepeat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="21" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:padding="18dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Aviso sonoro" style="@style/CardTitle" />
            <TextView android:id="@+id/tvAudioName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Pitido integrado" android:textColor="@color/brand"
                android:textSize="15sp" android:maxLines="2" />
            <Button android:id="@+id/btnChooseAudio" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Elegir audio del móvil" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnBuiltin" style="@style/SecondaryButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Pitido original" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/btnPreview" style="@style/SecondaryButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Escuchar prueba" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Volumen del aviso dentro de la app"
                style="@style/HintText" />
            <TextView android:id="@+id/tvVolumeValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" style="@style/ValueText" android:text="85 %" />
            <SeekBar android:id="@+id/seekVolume" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="100" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/HintText"
                android:text="El volumen multimedia del teléfono también debe estar activado. El modo silencio o No molestar puede afectar a la reproducción." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:padding="18dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Configuraciones rápidas" style="@style/CardTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" style="@style/HintText"
                android:text="Valores de partida: puedes ajustarlos después." />
            <Button android:id="@+id/btnIndividual" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Trabajo individual · sensible" />
            <Button android:id="@+id/btnGroup" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Trabajo en grupo · tolerante" />
            <Button android:id="@+id/btnExam" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Examen · muy sensible" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:paddingLeft="5dp"
            android:paddingRight="5dp" android:gravity="center"
            android:text="Sin Internet · No graba conversaciones · La vigilancia debe iniciarse con la aplicación abierta y se puede detener desde la notificación."
            style="@style/HintText" />
    </LinearLayout>
</ScrollView>
